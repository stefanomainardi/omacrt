#!/usr/bin/env bash
# Build omacrt from this checkout and install it for the current user:
# the launcher and the CLI into ~/.local/bin, the Omarchy bar plugin into
# ~/.config/omarchy/plugins. Re-run after pulling to update everything.
#
#   bin/omacrt-install            build and install
#   bin/omacrt-install --no-build install the binaries already built
#   bin/omacrt-install --uninstall
#                                      remove the binaries and the plugins
#   sudo bin/omacrt-install --uninstall-system
#                                      remove the boot time lease setup
#   sudo bin/omacrt-install --system
#                                      one-time root part: mark the DAC's
#                                      connector non-desktop at every boot so
#                                      omacrt can lease it (see
#                                      docs/15khz.md); the connector name comes from
#                                      OMACRT_CONNECTOR (default HDMI-A-1)
set -euo pipefail

here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
repo="$(cd "$here/.." && pwd)"
# Two layouts. In a checkout this script sits in `bin/` and everything it
# installs is built under `shell/target/release`. Installed from a package it
# sits in `/usr/share/omacrt/` beside the plugin sources, the binaries are
# already in `/usr/bin`, and there is no source tree to build: computing the
# repository root as the parent directory would make it `/usr/share` and the
# run would stop at the missing binary check.
packaged=0
if [ ! -d "$repo/shell" ] && [ -d "$here/plugin" ]; then
  packaged=1
  repo="$here"
fi
# Two channels. With Omarchy there is a bar widget, a library overlay and a
# Television entry in the desktop menu, and all three live in Omarchy's own
# extension points. Without it the television is identical and the desktop
# side is the command line, so nothing is written under ~/.config/omarchy at
# all: a plugin nothing loads and a menu file nothing reads are litter, and
# leaving somebody to wonder where the widget is, is worse than saying so.
have_omarchy=0
if command -v omarchy >/dev/null 2>&1; then
  have_omarchy=1
fi
# One piece of styling, and only in a terminal: the `==` lines are the steps,
# and in a wall of paths they are what the eye looks for. No palette in shell:
# the colours belong to `omacrt doctor`, which is where the setup is explained.
bold=""; plain=""
if [ -t 1 ] && [ -z "${NO_COLOR:-}" ] && [ "${TERM:-dumb}" != "dumb" ]; then
  bold=$'\033[1m'; plain=$'\033[0m'
fi
step() { echo "${bold}== $*${plain}"; }
plugin_id="io.github.stefanomainardi.omacrt"
library_id="${plugin_id}.library"
bin_dir="${HOME}/.local/bin"
plugin_dir="${HOME}/.config/omarchy/plugins/${plugin_id}"
library_dir="${HOME}/.config/omarchy/plugins/${library_id}"
build=1
# The status line the run ends on, from wherever the binary actually is.
say_status() {
  if [ "$packaged" = 1 ]; then
    "$built_dir/omacrt" status || true
  else
    "$bin_dir/omacrt" status || true
  fi
}
# The Television entry in the Omarchy menu. Omarchy reads
# ~/.config/omarchy/extensions/omarchy-menu.jsonc for exactly this, so the
# rows go in there between two markers: nothing patched, nothing forked, and
# taken back out on --uninstall.
menu_ext="${HOME}/.config/omarchy/extensions/omarchy-menu.jsonc"
menu_block="${repo}/menu/omarchy-menu.jsonc"

menu_strip() {  # print $menu_ext without our block
  [ -f "$menu_ext" ] || return 0
  # The old name wrote its own pair of markers; both are recognised so a
  # machine that had the block under `omarchy-crt` does not end up with two.
  #
  # A begin without its end used to swallow everything after it, permanently:
  # the block is only dropped when both markers are found, and a file with a
  # dangling begin is handed back untouched for a person to look at.
  awk '
    /^\/\/ (omacrt|omarchy-crt): begin/ { skip = 1 }
    !skip { keep[++n] = $0 }
    /^\/\/ (omacrt|omarchy-crt): end/ { if (skip) { skip = 0; closed = 1 } }
    { all[NR] = $0 }
    END {
      if (skip && !closed) {
        for (i = 1; i <= NR; i++) print all[i]
        exit 0
      }
      for (i = 1; i <= n; i++) print keep[i]
    }
  ' "$menu_ext"
}

menu_install() {
  [ -f "$menu_block" ] || return 0
  mkdir -p "$(dirname "$menu_ext")"
  local kept
  kept="$(menu_strip)"
  if [ -f "$menu_ext" ]; then
    cp -f "$menu_ext" "${menu_ext}.omacrt.bak"
  else
    kept='{'$'\n''}'
  fi
  # The block goes in before the closing brace of the object.
  printf '%s\n' "$kept" | python3 -c '
import sys, pathlib
text = sys.stdin.read()
block = pathlib.Path(sys.argv[1]).read_text()
at = text.rfind("}")
if at < 0:
    text, at = "{\n}\n", 1
sys.stdout.write(text[:at] + block + text[at:])
' "$menu_block" > "${menu_ext}.new"
  mv -f "${menu_ext}.new" "$menu_ext"
  step "Television added to the Omarchy menu ($menu_ext)"
}

# What the project left behind under its old name.
#
# The launcher was `omarchy-crt` until it became OmaCRT, and a machine that
# installed it then still has its binaries in ~/.local/bin and its two plugins
# enabled in the bar: left alone, the bar would show the widget twice and the
# old commands would keep running an older build. Everything is moved into one
# folder rather than deleted, so it can be looked at or put back by hand.
legacy_plugin_id="io.github.stefanomainardi.omarchy-crt"
legacy_retired="${HOME}/.local/share/omacrt/retired"

retire() {  # $1 = what to move, $2 = subfolder of $legacy_retired
  [ -e "$1" ] || return 0
  mkdir -p "$legacy_retired/$2"
  mv -f "$1" "$legacy_retired/$2/" && step "retired $1 to $legacy_retired/$2/"
}

# The binaries: nothing watches ~/.local/bin, so this is safe at any time.
legacy_retire_bin() {
  for b in omarchy-crt omarchy-crt-shell omarchy-crt-display omarchy-crt-pick; do
    retire "${bin_dir}/${b}" bin
  done
}

# The plugin folders: the shell watches these and reloads plugin code on any
# change, and under the lock screen that reload aborts Quickshell - which is
# what the installer already stops before the plugin step for. Moving a
# watched folder is a change in the watched tree, so this waits for the same
# unlocked desktop the plugin install does.
legacy_retire_plugins() {
  local dir
  for id in "${legacy_plugin_id}.library" "$legacy_plugin_id"; do
    dir="${HOME}/.config/omarchy/plugins/${id}"
    [ -d "$dir" ] || continue
    command -v omarchy >/dev/null 2>&1 && omarchy plugin disable "$id" >/dev/null 2>&1 || true
    retire "$dir" plugins
  done
}

menu_remove() {
  [ -f "$menu_ext" ] || return 0
  menu_strip > "${menu_ext}.new"
  mv -f "${menu_ext}.new" "$menu_ext"
  step "Television removed from the Omarchy menu"
}

for arg in "$@"; do
  case "$arg" in
    --system)
      [ "$(id -u)" = 0 ] || { echo "--system needs root: sudo $0 --system" >&2; exit 1; }
      conn="${OMACRT_CONNECTOR:-HDMI-A-1}"
      # The same check crt-lease-setup.sh makes at runtime. This value is
      # interpolated into a sed replacement that writes a root owned unit
      # file, and a newline in it becomes a new directive in that file.
      case "$conn" in
        *[!A-Za-z0-9-]*|"") echo "not a connector name: $conn" >&2; exit 1 ;;
      esac
      step "installing the lease setup for $conn (root)"
      install -d -m 755 /usr/local/lib/omacrt
      install -m 755 "$repo/scripts/crt-lease-setup.sh" "$repo/scripts/edid-non-desktop.py" /usr/local/lib/omacrt/
      sed "s/^Environment=OMACRT_CONNECTOR=.*/Environment=OMACRT_CONNECTOR=$conn/" "$repo/systemd/omacrt-lease.service" > /etc/systemd/system/omacrt-lease.service
      # The unit the old name installed would run the same setup at the next
      # boot. It is disabled but not stopped: its ExecStop takes the EDID
      # override back off the connector, which a running launcher is leasing.
      if [ -f /etc/systemd/system/omarchy-crt-lease.service ]; then
        systemctl disable omarchy-crt-lease.service >/dev/null 2>&1 || true
        step "the old omarchy-crt-lease.service is disabled; it stays loaded until the next boot"
      fi
      systemctl daemon-reload
      systemctl enable --now omacrt-lease.service
      systemctl --no-pager --lines=3 status omacrt-lease.service || true
      echo "done: $conn is handed to omacrt at boot (reverse: systemctl disable --now omacrt-lease.service)"
      exit 0
      ;;
    --no-build) build=0 ;;
    --uninstall)
      # Everything this installer put in place, taken back out. The user's
      # games, configuration and cache are never touched.
      if [ "$have_omarchy" = 1 ]; then
        menu_remove
      fi
      if [ "$packaged" = 1 ]; then
        step "the binaries belong to the package; remove it with pacman"
      else
        step "removing the binaries from $bin_dir"
        for b in omacrt omacrt-shell omacrt-display omacrt-pick; do
          rm -f "$bin_dir/$b"
        done
      fi
      if [ "$have_omarchy" = 0 ]; then
        echo "done. Your games, settings and cache are where they were."
        exit 0
      fi
      step "removing the plugins"
      if command -v omarchy-shell >/dev/null 2>&1 && [ "$(omarchy-shell lock isLocked 2>/dev/null)" = "true" ]; then
        echo "note: the session is locked; run this again unlocked to remove the plugins"
      else
        command -v omarchy >/dev/null 2>&1 && {
          omarchy plugin disable "$library_id" >/dev/null 2>&1 || true
          omarchy plugin disable "$plugin_id" >/dev/null 2>&1 || true
        }
        rm -rf "$plugin_dir" "$library_dir"
        command -v omarchy-shell >/dev/null 2>&1 && omarchy-shell shell rescanPlugins >/dev/null 2>&1 || true
      fi
      if [ -f /etc/systemd/system/omacrt-lease.service ]; then
        echo "the boot time lease setup is still installed; remove it with:"
        echo "  sudo $0 --uninstall-system"
      fi
      echo "done. Your games, settings and cache are where they were."
      exit 0
      ;;
    --uninstall-system)
      [ "$(id -u)" = 0 ] || { echo "--uninstall-system needs root: sudo $0 --uninstall-system" >&2; exit 1; }
      systemctl disable --now omacrt-lease.service >/dev/null 2>&1 || true
      rm -f /etc/systemd/system/omacrt-lease.service
      rm -rf /usr/local/lib/omacrt
      systemctl daemon-reload
      echo "done: the connector goes back to the desktop at the next boot"
      exit 0
      ;;
    -h|--help) sed -n '2,12p' "$0"; exit 0 ;;
    *) echo "unknown option $arg" >&2; exit 1 ;;
  esac
done

if [ "$packaged" = 1 ]; then
  build=0
fi

if [ "$build" = 1 ]; then
  step "building (cargo build --release)"
  (cd "$repo/shell" && cargo build --release)
fi

# Where the built things are: the package puts them on the PATH, a checkout
# leaves them under the target directory.
if [ "$packaged" = 1 ]; then
  # The package's own binaries, not whatever an older manual install left
  # earlier on the PATH.
  if [ -x /usr/bin/omacrt ]; then
    built_dir=/usr/bin
  else
    built_dir="$(dirname "$(command -v omacrt || echo /usr/bin/omacrt)")"
  fi
  picker="$here/omacrt-pick"
else
  built_dir="$repo/shell/target/release"
  picker="$repo/bin/omacrt-pick"
fi

for b in omacrt omacrt-shell omacrt-display; do
  [ -x "$built_dir/$b" ] || { echo "missing $built_dir/$b" >&2; exit 1; }
done
[ -f "$picker" ] || { echo "missing $picker" >&2; exit 1; }

# Before anything new goes in, the old binaries are moved aside. The old
# plugin folders wait for the lock check below.
legacy_retire_bin

if [ "$packaged" = 1 ]; then
  # The package owns /usr/bin; only the plugins and the menu entry are this
  # script's business there.
  step "the binaries come from the package in $built_dir"
else
  step "installing binaries into $bin_dir"
  mkdir -p "$bin_dir"
  install -m 755 "$built_dir/omacrt" "$bin_dir/omacrt"
  install -m 755 "$built_dir/omacrt-shell" "$bin_dir/omacrt-shell"
  install -m 755 "$built_dir/omacrt-display" "$bin_dir/omacrt-display"
  # The desktop picker: a script, not a binary, but it belongs beside them.
  install -m 755 "$picker" "$bin_dir/omacrt-pick"
fi
case ":$PATH:" in
  *":$bin_dir:"*) ;;
  *) echo "note: $bin_dir is not in PATH" ;;
esac

# The menu entry is a line in a file Omarchy reads for user extensions, not a
# plugin folder, so it goes in whether or not the session is locked: nothing
# reloads plugin code because of it.
if [ "$have_omarchy" = 1 ]; then
  menu_install
fi

if [ "$have_omarchy" = 0 ]; then
  echo
  step "no Omarchy here: this install is the television and the command line"
  echo "   not installed: the bar widget, the panel, the library overlay and"
  echo "   the Television entry in the desktop menu. They are Omarchy plugins"
  echo "   and there is nothing here to load them."
  echo "   instead: omacrt, and Hyprland keybindings that call it. The bindings"
  echo "   are in docs/hyprland.md."
  echo
  say_status
  echo
  echo "next: omacrt doctor   (it says whether this machine can drive a tube)"
  exit 0
fi

# The shell watches its plugin folders and reloads plugin code on any file
# change; under the lock screen that reload aborts Quickshell (its lock plugin
# re-creates surfaces without an active lock). Plugin files wait for an
# unlocked desktop; the binaries in ~/.local/bin are in place already.
if command -v omarchy-shell >/dev/null 2>&1 && [ "$(omarchy-shell lock isLocked 2>/dev/null)" = "true" ]; then
  echo "note: the session is locked; run this again unlocked to update the bar plugin"
  if [ -d "${HOME}/.config/omarchy/plugins/${legacy_plugin_id}" ]; then
    echo "note: the plugins under the old name are still enabled until then"
  fi
  say_status
  exit 0
fi

legacy_retire_plugins

step "installing the plugins into $plugin_dir and $library_dir"
# The binary carries the plugin files and writes the ones that differ:
# `omacrt plugin sync`. One implementation rather than two, and the same
# command puts them right after an upgrade, which this script cannot be
# there for. Overwrite in place: removing a folder makes the shell drop the
# plugin for a moment and the bar widget vanishes; changed files hot reload.
#
# A copy, not a link, because Omarchy's plugin validator refuses a symlink
# inside a plugin folder.
"$built_dir/omacrt" plugin sync --install

# Hot reloading plugin code while the session is locked makes the shell's
# lock plugin re-create its surfaces without an active lock, which Quickshell
# treats as fatal: the shell crashes and restarts on top of the lock screen.
# The files are in place already; the reload waits for an unlocked desktop.
if command -v omarchy >/dev/null 2>&1; then
  omarchy plugin validate "$plugin_dir"
  omarchy plugin validate "$library_dir"
  if ! omarchy plugin list --json 2>/dev/null | grep -q "\"$library_id\""; then
    omarchy-shell shell rescanPlugins >/dev/null 2>&1 || true
  fi
  enabled() {  # $1 = plugin id; true when listed and enabled
    omarchy plugin list --json 2>/dev/null | python3 -c '
import json,sys
pl=[p for p in json.load(sys.stdin) if p.get("id")==sys.argv[1]]
sys.exit(0 if pl and pl[0].get("enabled") else 1)' "$1"
  }
  enabled "$plugin_id" || omarchy plugin enable "$plugin_id" right
  enabled "$library_id" || omarchy plugin enable "$library_id"
  omarchy-shell shell rescanPlugins >/dev/null 2>&1 || true
fi

say_status
echo "done. Try: omacrt on"
