# Maintainer: Stefano Mainardi <https://www.stefanomainardi.com>
#
# An Arch package for people who would rather not clone and build by hand.
# It installs the three binaries, the bar plugin and the overlay into
# /usr/share, the systemd unit and the root helpers. The per user parts, the
# plugin symlinks into ~/.config/omarchy/plugins, stay with the installer
# script, since they belong to a session and not to the system.

pkgname=omacrt
pkgver=0.4.1
pkgrel=1
pkgdesc="An Omarchy edition for retro gaming on 15 kHz CRT televisions"
arch=('x86_64')
url="https://github.com/stefanomainardi/omacrt"
license=('MIT')
depends=('sdl2' 'systemd-libs' 'libinput' 'libxkbcommon' 'mesa' 'seatd'
         'ffmpeg' 'curl')
optdepends=('retroarch: playing games'
            'mpv: films and YouTube on the tube'
            'yt-dlp: YouTube search and streams'
            'cliamp: radio, Spotify and the music deck'
            'python: the boot time EDID override'
            'i2c-tools: talking to the DAC by hand')
makedepends=('cargo' 'git')
provides=('omacrt')
conflicts=('omacrt-git')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP')
install="$pkgname.install"

prepare() {
  cd "$pkgname-$pkgver/shell"
  export RUSTUP_TOOLCHAIN=stable
  # No fallback: without --locked a build can resolve a different dependency
  # set from the one the release was tested with, which is the opposite of
  # what a package is for. A lock file that needs changing is a change to
  # commit, not something to paper over at build time.
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "$pkgname-$pkgver/shell"
  export RUSTUP_TOOLCHAIN=stable CARGO_TARGET_DIR=target
  cargo build --release --frozen
}

check() {
  cd "$pkgname-$pkgver/shell"
  export RUSTUP_TOOLCHAIN=stable
  # The suite that does not need a television.
  cargo test --release --frozen
}

package() {
  cd "$pkgname-$pkgver"
  for b in omacrt omacrt-shell omacrt-display; do
    install -Dm755 "shell/target/release/$b" "$pkgdir/usr/bin/$b"
  done

  # The root part of the lease setup.
  install -Dm755 scripts/crt-lease-setup.sh \
    "$pkgdir/usr/lib/omacrt/crt-lease-setup.sh"
  install -Dm755 scripts/edid-non-desktop.py \
    "$pkgdir/usr/lib/omacrt/edid-non-desktop.py"
  sed 's#/usr/local/lib/omacrt#/usr/lib/omacrt#g' \
    systemd/omacrt-lease.service \
    > "$srcdir/omacrt-lease.service"
  install -Dm644 "$srcdir/omacrt-lease.service" \
    "$pkgdir/usr/lib/systemd/system/omacrt-lease.service"

  # The Omarchy plugins, from where the installer script links them.
  install -d "$pkgdir/usr/share/omacrt/plugin"
  cp -r plugin/. "$pkgdir/usr/share/omacrt/plugin/"
  install -Dm755 bin/omacrt-install \
    "$pkgdir/usr/share/omacrt/omacrt-install"

  # The Television rows the installer merges into Omarchy's menu extension
  # file. Without them the packaged installer has nothing to add.
  install -Dm644 menu/omarchy-menu.jsonc \
    "$pkgdir/usr/share/omacrt/menu/omarchy-menu.jsonc"

  # The picker is a script rather than a build product, and the packaged
  # installer needs it beside itself.
  install -Dm755 bin/omacrt-pick "$pkgdir/usr/share/omacrt/omacrt-pick"

  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  # The wordmark's letterforms are Omarchy's, MIT, and MIT asks that its
  # notice travel with them. The binary carries the letterforms, so the
  # package carries the notice.
  install -Dm644 shell/assets/LICENSE.omarchy \
    "$pkgdir/usr/share/licenses/$pkgname/LICENSE.omarchy"
  install -Dm644 LICENSE-SCOPE.md "$pkgdir/usr/share/licenses/$pkgname/LICENSE-SCOPE.md"
  install -Dm644 THIRD-PARTY.md "$pkgdir/usr/share/licenses/$pkgname/THIRD-PARTY.md"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
  install -Dm644 SECURITY.md "$pkgdir/usr/share/doc/$pkgname/SECURITY.md"
  install -Dm644 CHANGELOG.md "$pkgdir/usr/share/doc/$pkgname/CHANGELOG.md"
  for d in docs/*.md; do
    install -Dm644 "$d" "$pkgdir/usr/share/doc/$pkgname/$(basename "$d")"
  done
}
